-- HTTP Client Functions

-- Get Access Token (https://developers.zoom.us/docs/internal-apps/s2s-oauth/#generate-access-token)
-- The token is the owner's access token.
-- The token's time to live is one hour (3600 seconds).
-- There is no refresh token.
-- You can generate and use multiple access tokens.
-- Tokens stop working when the app is deactivated.
-- Server-to-Server OAuth apps can be deleted.
-- Account administrators authorize the scopes available to developers building these app types.

function GetAccessToken()
  HttpClient.Post {
    Url = "https://zoom.us/oauth/token",
    Data = "grant_type=account_credentials&account_id="..Controls["AccountID"].String,
    Headers = {
      ["Content-Type"] = "application/x-www-form-urlencoded",
      ["Authorization"] = "Basic "..Crypto.Base64Encode(Controls["ClientID"].String..":"..Controls["ClientSecret"].String)
    },
    EventHandler = tokenPostDone -- The function to call upon response
  }

  -- If this is the first request after script starts, update status to Initializing.
  if InitialAccessTokenRequest == true then
    -- Set Status to Initializing - Requesting OAuth Access Token to access Organisation Zoom Account.
    SetStatus(5, "Requesting OAuth Access Token to access Organisation Zoom Account.")
  end

  -- Clear the AllZoomRooms{} table and resets NumberOfZoomRooms at each token request.
  --AllZoomRooms = {}
  --NumberOfZoomRooms = 0
end

function tokenPostDone(tbl, code, data, err)
  print(string.format("Response Code: %i\t\tErrors: %s\rData: %s",code, err or "None", data))

  if code == 400 then 
    reason = json.decode(data).reason
    error = json.decode(data).error
    -- Set Status to Compromised and end function.
    SetStatus(1, "Access Token Failure: "..reason.." : "..error)
  return end 

  access_token = json.decode(data).access_token
  token_type = json.decode(data).token_type
  expires_in = json.decode(data).expires_in
  scope = json.decode(data).scope
  api_url = json.decode(data).api_url
  print("Access Token: \n"..access_token)
  print("Token Type: "..token_type)
  print("Expires In: "..expires_in)
  print("Scope: \n"..scope:gsub(" ", "\n")) -- \n and gsub used to print each Scope on a new line in the Debug Output.
  print("API URL: "..api_url)

  -- Start timer to generate a new token before token expires. Dividing original token time to live by 2 in order to ensure token doesn't expire.
  -- The token's time to live is one hour (3600 seconds).
  if expires_in then
    tokenTimer:Start(math.floor(expires_in/2))
    print("Token timer started: "..math.floor(expires_in/2) .. "secs")
  end

  -- Send GET request: List Zoom Rooms https://api.zoom.us/v2/rooms?type=ZoomRoom
  -- Requesting only 'ZoomRoom' "type" and populate the AllZoomRooms{} table. ("zoom_room_type": "ZoomRoom")
  -- Requesting the "page_size" is 100 (default is 30) to reduce the number of responses.
  if access_token then
    GetRequest("?type=ZoomRoom&page_size=100")
    --GetRequest("?type=ZoomRoom")
    --GetRequest("")
    --GetRequest("?page_size=100")
  end

end

-- When tokenTimer expires, send HttpClient.Post request for new token.
tokenTimer.EventHandler = function()
  GetAccessToken()
end



-- GET Requests 
function GetRequest(data)
  HttpClient.Download {
    Url = "https://api.zoom.us/v2/rooms"..data,
    --Data = data,
    Headers = {
      ["Content-Type"] = "application/json",
      ["Authorization"] = "Bearer "..access_token -- access token obtained using GetAccessToken()
    },
    Timeout = 30,
    EventHandler = GetRequestDone -- The function to call upon response
  }
end

function GetRequestDone(tbl, code, data, err, headers)
  print(string.format( "HTTP response from '%s': Return Code=%i; Error=%s", tbl.Url, code, err or "None" ) )

  -- Decode the response, then encode to print pretty.
  local getdata = json.decode(data)
  print( "\rHTML Data: \n"..json.encode(getdata, {pretty = true}))


  -- If "rooms" table is returned (https://api.zoom.us/v2/rooms/) then create a table of all Rooms.
  if getdata.rooms then

    -- When the number of rooms within getdata.rooms is just 1 room, this will be the Get request to update the status of the room being controlled.
    if getdata.rooms and #getdata.rooms == 1 and getdata.rooms[1].name == Controls["Room Name"].String then

      for i, room in ipairs(getdata.rooms) do
          -- local variable for exisiting table
          local exsitingtable = AllZoomRooms[room.name] or {}
          -- merge new data into existing table.
          exsitingtable.id = room.id
          exsitingtable.room_id = room.room_id
          exsitingtable.location_id = room.location_id
          exsitingtable.status = room.status
          exsitingtable.tag_ids = room.tag_ids
          -- update the AllZoomRooms table
          AllZoomRooms[room.name] = exsitingtable
      end
        Controls["Room Status"].String = AllZoomRooms[Controls["Room Name"].String].status
        if AllZoomRooms[Controls["Room Name"].String].status == "InMeeting" then 
          Controls["In Meeting"].Boolean = true
          -- Set Status to OK - In Meeting
          SetStatus(0, "In Meeting")
        elseif AllZoomRooms[Controls["Room Name"].String].status == "Available" then
          Controls["In Meeting"].Boolean = false
          -- Set Status to OK - Available
          SetStatus(0, "Available")
        elseif AllZoomRooms[Controls["Room Name"].String].status == "UnderConstruction" then
          Controls["In Meeting"].Boolean = false
          -- Set Status to Not Present - Under Construction
          SetStatus(3, "Under Construction")
        elseif AllZoomRooms[Controls["Room Name"].String].status == "Offline" then
          Controls["In Meeting"].Boolean = false
          -- Set Status to Fault - Offline
          SetStatus(2, "Offline")
        end
    return end


    for i, room in ipairs(getdata.rooms) do
        -- local variable for exisiting table
        local exsitingtable = AllZoomRooms[room.name] or {}
        -- merge new data into existing table.
        exsitingtable.id = room.id
        exsitingtable.room_id = room.room_id
        exsitingtable.location_id = room.location_id
        exsitingtable.status = room.status
        exsitingtable.tag_ids = room.tag_ids
        -- update the AllZoomRooms table
        AllZoomRooms[room.name] = exsitingtable
    end

    -- Add the number of Zoom Rooms found in getdata.rooms to a global variable.
    -- NumberOfZoomRooms = NumberOfZoomRooms + (#getdata.rooms)

    -- If there is more than one page of rooms in the list (depending on page_size parameter sent), a next_page_token will be provided to be used as a param for a follow-up request.
    -- If no ?page_size= param is sent, the default is 30 rooms per response. Maximum is ?page_size=300.
    -- NOTE: if a ?page_size= param is sent on the initial GET request, that same page size param needs to be sent with the next_page_token param. (eg. GetRequest("?page_size=100&next_page_token="..pageToken))
    -- NOTE: if no ?page_size= param is sent, the default (30) needs to be included in any follow-up requests (ie. GetRequest("?page_size=30&next_page_token="..pageToken))
    -- NOTE: you must also include any other params that were included in the intial GET request (eg. "?type=ZoomRoom" )
    if getdata.next_page_token ~= "" then
      local pageToken = getdata.next_page_token
      GetRequest("?type=ZoomRoom&page_size=100&next_page_token="..pageToken)
      --GetRequest("?page_size=100&next_page_token="..pageToken)

      if InitialAccessTokenRequest == true then
        -- Set Status to Initializing - Building AllZoomRooms table.
        SetStatus(5, "Access Token success! Building 'AllZoomRooms' table.")
        -- Set InitialAccessTokenRequest to false to prevent repeating Initializing status when GetAccessToken is run again.
        InitialAccessTokenRequest = false
      end
    end
    
    -- If next_page_token is not returned, this is the end of the rooms list.
    -- Print the AllZoomRooms table and check table contains all of the organisation accounts Zoom Rooms.
    -- Then, send the Get Zoom Room profile request to add details into the AllZoomRooms table (ie. zoom_room_type, room_passcode, hide_room_in_contacts, under_construction)
    if getdata.next_page_token == "" then
    
      print(json.encode(AllZoomRooms, {pretty = true}))
      
      -- Print the number of rooms added to the AllZoomRooms table and update AllZoomRoomsTableCount variable.
      local roomcount = 0
      for i in pairs(AllZoomRooms) do
        roomcount = roomcount + 1
      end

      AllZoomRoomsTableCount = roomcount
      Controls["Number Of Zoom Rooms"].String = AllZoomRoomsTableCount
      print(AllZoomRoomsTableCount..": AllZoomRooms Table (type=ZoomRoom)")
      
      -- Print the number of rooms from GET request. The size of this will be 
      --print(NumberOfZoomRooms..": Number Of Zoom Rooms (type=ZoomRoom) within organisation account.")

      -- Send GET Zoom Room profile request for each room = https://api.zoom.us/v2/rooms/{roomId}
      BuildRoomProflies()

    end


  -- Zoom Room Profile.
  -- If "basic", "device" and "setup" tables are returned (https://api.zoom.us/v2/rooms/{roomId}) add this information to AllZoomRooms table.
  elseif getdata.basic and getdata.device and getdata.setup then
    -- Basic table.
    AllZoomRooms[getdata.basic.name]["basic"] = getdata.basic

    -- Update script/plugin controls for the Zoom Room being controlled.
    if AllZoomRooms[Controls["Room Name"].String] ~= nil and AllZoomRooms[Controls["Room Name"].String].basic ~= nil and AllZoomRooms[Controls["Room Name"].String].basic.name == Controls["Room Name"].String then
      -- Room Passcode
      if AllZoomRooms[Controls["Room Name"].String].basic.room_passcode == "" then 
        Controls["Room Passcode"].String = "Not Set"  
      else
        Controls["Room Passcode"].String = AllZoomRooms[Controls["Room Name"].String].basic.room_passcode
      end
      -- Activation Code
      if AllZoomRooms[Controls["Room Name"].String].basic.activation_code == "" then 
        Controls["Activation Code"].String = "Not Set"  
      else
        Controls["Activation Code"].String = AllZoomRooms[Controls["Room Name"].String].basic.activation_code
      end
      -- Display Name
      if AllZoomRooms[Controls["Room Name"].String].basic.display_name == "" then 
        Controls["Display Name"].String = "Not Set"  
      else
        Controls["Display Name"].String = AllZoomRooms[Controls["Room Name"].String].basic.display_name
      end
      -- Capacity
      if AllZoomRooms[Controls["Room Name"].String].basic.capacity == "" then 
        Controls["Capacity"].String = "Not Set"  
      else
        Controls["Capacity"].String = AllZoomRooms[Controls["Room Name"].String].basic.capacity
      end
      -- Support Phone
      if AllZoomRooms[Controls["Room Name"].String].basic.support_phone == "" then 
        Controls["Support Phone"].String = "Not Set"  
      else
        Controls["Support Phone"].String = AllZoomRooms[Controls["Room Name"].String].basic.support_phone
      end
      -- Hide Room In Contacts
      Controls["Hide Room In Contacts"].Boolean = AllZoomRooms[Controls["Room Name"].String].basic.hide_room_in_contacts
    end


    -- Setup Table
    AllZoomRooms[getdata.basic.name]["setup"] = getdata.setup

    -- Update script/plugin controls for the Zoom Room being controlled.
    if AllZoomRooms[Controls["Room Name"].String] ~= nil and AllZoomRooms[Controls["Room Name"].String].setup ~= nil and AllZoomRooms[Controls["Room Name"].String].basic.name == Controls["Room Name"].String then
      -- Under Construction
      Controls["Under Construction"].Boolean = AllZoomRooms[Controls["Room Name"].String].setup.under_construction
      -- Update Controller URL string - URL is unavailable when room is Under Construction
      if AllZoomRooms[Controls["Room Name"].String].setup.under_construction == true then 
        Controls["Controller URL"].String = "Unavailable when Under Construction."
      end
    end


    -- Device Table
    -- Response contains "device_profile_id" -> not used in this script.
    AllZoomRooms[getdata.basic.name]["device"] = getdata.device


  -- Devices Table
  -- List Zoom Room Devices - Devices that are Signed In to the Zoom Room.
  -- "device_type": "Controller" appears to be DTEN Mate or iPad controllers.
  -- "device_type": "Zoom Rooms Computer" appears to be Zoom PC's, DTEN All-In-One devices (DTEN D7, DTEN ME).
  -- "device_type": "Zoom Rooms Control System" appears to be rooms using the ZR-CSAPI (eg. Q-Sys Cores). Not useful information for this script and being depreciated.
  -- "device_type": "Scheduling Display" appears to be DTEN Mates configured as scheduling display.
  -- "device_type": "Companion Whiteboard".
  elseif getdata.devices then
    AllZoomRooms[Controls["Room Name"].String]["devices"] = getdata.devices

    if AllZoomRooms[Controls["Room Name"].String].devices ~= nil and AllZoomRooms[Controls["Room Name"].String].basic.name == Controls["Room Name"].String then  
      for i, dev in ipairs(getdata.devices) do 
        if dev.device_type == "Controller" then
          if dev.device_manufacturer then Controls["Controller Manufacturer"].String = dev.device_manufacturer end
          if dev.device_model then Controls["Controller Model"].String = dev.device_model end
          if dev.serial_number then Controls["Controller Serial"].String = dev.serial_number end
          if dev.app_version then Controls["Controller App Version"].String = dev.app_version end
          if dev.device_system then Controls["Controller System"].String = dev.device_system end
          if dev.device_hostname then Controls["Controller Hostname"].String = dev.device_hostname end
          if dev.device_firmware then Controls["Controller Firmware"].String = dev.device_firmware end
          if dev.ip_address then Controls["Controller IP Address"].String = dev.ip_address end
          if dev.status then Controls["Controller Status"].String = dev.status end
        elseif dev.device_type == "Zoom Rooms Computer" then
          if dev.device_model then Controls["Computer Model"].String = dev.device_model end
          if dev.serial_number then Controls["Computer Serial"].String = dev.serial_number end
          if dev.app_version then Controls["Computer App Version"].String = dev.app_version end
          if dev.device_system then Controls["Computer System"].String = dev.device_system end
          if dev.device_hostname then Controls["Computer Hostname"].String = dev.device_hostname end
          if dev.ip_address then Controls["Computer IP Address"].String = dev.ip_address end
          if dev.status then Controls["Computer Status"].String = dev.status end
        elseif dev.device_type == "Scheduling Display" then
          if dev.device_manufacturer then Controls["Scheduling Display Manufacturer"].String = dev.device_manufacturer end
          if dev.device_model then Controls["Scheduling Display Model"].String = dev.device_model end
          if dev.serial_number then Controls["Scheduling Display Serial"].String = dev.serial_number end
          if dev.app_version then Controls["Scheduling Display App Version"].String = dev.app_version end
          if dev.device_system then Controls["Scheduling Display System"].String = dev.device_system end
          if dev.device_hostname then Controls["Scheduling Display Hostname"].String = dev.device_hostname end
          if dev.device_firmware then Controls["Scheduling Display Firmware"].String = dev.device_firmware end
          if dev.ip_address then Controls["Scheduling Display IP Address"].String = dev.ip_address end
          if dev.status then Controls["Scheduling Display Status"].String = dev.status end
        elseif dev.device_type == "Companion Whiteboard" then
          if dev.device_model then Controls["Companion Whiteboard Model"].String = dev.device_model end
          if dev.serial_number then Controls["Companion Whiteboard Serial"].String = dev.serial_number end
          if dev.app_version then Controls["Companion Whiteboard App Version"].String = dev.app_version end
          if dev.device_system then Controls["Companion Whiteboard System"].String = dev.device_system end
          if dev.device_hostname then Controls["Companion Whiteboard Hostname"].String = dev.device_hostname end
          if dev.ip_address then Controls["Companion Whiteboard IP Address"].String = dev.ip_address end
          if dev.status then Controls["Companion Whiteboard Status"].String = dev.status end
        end
      end
    end


  -- Zoom Room Device Information - Devices connected to the Zoom Room (Eg. cameras, microphones, speakers)
  elseif getdata.cameras or getdata.speakers or getdata.microphones then

    -- Cameras Table  
    if getdata.cameras then
      local cameras = {}
      AllZoomRooms[Controls["Room Name"].String]["cameras"] = getdata.cameras
        for i in pairs(getdata.cameras) do
          --print("Camera: "..getdata.cameras[i].name)
          --print("Camera: "..getdata.cameras[i].id)
          table.insert(cameras, getdata.cameras[i].name)
        end
      -- Sort the cameras table alphabetically.
      table.sort(cameras)
      Controls["Cameras"].Choices = cameras
    end

    -- Speakers Table
    if getdata.speakers then
      local speakers = {}
      AllZoomRooms[Controls["Room Name"].String]["speakers"] = getdata.speakers
        for i in pairs(getdata.speakers) do
          --print("Speaker: "..getdata.speakers[i].name)
          --print("Speaker: "..getdata.speakers[i].id)
          table.insert(speakers, getdata.speakers[i].name)
        end
      -- Sort the speakers table alphabetically.
      table.sort(speakers)
      Controls["Speakers"].Choices = speakers  
    end

    -- Microphones Table
    if getdata.microphones then
      local microphones = {}
      AllZoomRooms[Controls["Room Name"].String]["microphones"] = getdata.microphones
      for i in pairs(getdata.microphones) do
        --print("Microphone: "..getdata.microphones[i].name)
        --print("Microphone: "..getdata.microphones[i].id)
        table.insert(microphones, getdata.microphones[i].name)
      end
      -- Sort the microphones table alphabetically.
      table.sort(microphones)
      Controls["Microphones"].Choices = microphones  
  end 
  
  
  -- Zoom Room Settings: setting_type=alert
  -- This information is added to the AllZoomRooms table for the controlled room.
  elseif getdata.notification and getdata.client_alert then
    AllZoomRooms[Controls["Room Name"].String]["notification"] = getdata.notification
    AllZoomRooms[Controls["Room Name"].String]["client_alert"] = getdata.client_alert
    
    if AllZoomRooms[Controls["Room Name"].String].zoom_rooms ~= nil and AllZoomRooms[Controls["Room Name"].String].basic.name == Controls["Room Name"].String then
      -- Alert Speaker Error - Alert when detect speaker error
      Controls["Alert Speaker Error"].Boolean = AllZoomRooms[Controls["Room Name"].String].client_alert.detect_speaker_error_alert
      -- Alert Microphone Error - Alert when detect microphone error
      Controls["Alert Microphone Error"].Boolean = AllZoomRooms[Controls["Room Name"].String].client_alert.detect_microphone_error_alert
      -- Alert Camera Error - Alert when detect camera error
      Controls["Alert Camera Error"].Boolean = AllZoomRooms[Controls["Room Name"].String].client_alert.detect_camera_error_alert
      -- Alert CPU Usage - The alert will display when CPU usage is above 90%
      Controls["Alert CPU Usage"].Boolean = AllZoomRooms[Controls["Room Name"].String].client_alert.cpu_usage_high_detected_notification_on_zr_display
      -- Alert Unstable Network - The alert will display when the network connection bandwidth is low, or the connection is unstable.
      Controls["Alert Unstable Network"].Boolean = AllZoomRooms[Controls["Room Name"].String].client_alert.network_unstable_detected_notification_on_zr_display

      -- Notification Audio Quality - Send an email when the audio echo test result does not meet usability threshold.
      Controls["Notification Audio Quality"].Boolean = AllZoomRooms[Controls["Room Name"].String].notification.audio_not_meet_usability_threshold
      -- Notification Controller Battery Low - Controller or scheduling display battery is low. Send an email when the battery is low and is not charging
      Controls["Notification Controller Battery Low"].Boolean = AllZoomRooms[Controls["Room Name"].String].notification.battery_low_and_not_charging
      -- Notification Controller Disconnected - Controller or scheduling display disconnected. Send an email when the connection to the Controller or Scheduling Display cannot be detected.
      Controls["Notification Controller Disconnected"].Boolean = AllZoomRooms[Controls["Room Name"].String].notification.controller_scheduling_disconnected
      -- Notification High CPU Usage - High CPU usage is detected. Send an email when CPU usage is above 90%.
      Controls["Notification High CPU Usage"].Boolean = AllZoomRooms[Controls["Room Name"].String].notification.cpu_usage_high_detected
      -- Notification Network Unstable - Low bandwidth network is detected. Send an email when the network is unstable.
      Controls["Notification Network Unstable"].Boolean = AllZoomRooms[Controls["Room Name"].String].notification.network_unstable_detected
      -- Notification Zoom Room Offline - Zoom Room is offline. Send an email when the machine hosting the Zoom Room application has a network issue or cannot connect with the Controller.
      Controls["Notification Zoom Room Offline"].Boolean = AllZoomRooms[Controls["Room Name"].String].notification.zoom_room_offline
      -- Notification Calendar Inaccessible - Zoom Room calendar resource is inaccessible. Send an email when a Zoom Room with calendar integration configured is unable to access its associated calendar resource.
      Controls["Notification Calendar Inaccessible"].Boolean = AllZoomRooms[Controls["Room Name"].String].notification.zoom_room_calendar_resource_is_inaccessible
      -- Notification SIP Registration Failed - SIP registration has failed. Send an email when SIP registration stops working. Enter credentials in the Cloud Console to re-register.
      Controls["Notification SIP Registration Failed"].Boolean = AllZoomRooms[Controls["Room Name"].String].notification.sip_registration_failed
      -- Notification Mic Speaker Camera Disconnected - Selected mic, speaker or camera has disconnected. Send an email when the mic, speaker or camera is disconnected by the Zoom Room.
      Controls["Notification Mic Speaker Camera Disconnected"].Boolean = AllZoomRooms[Controls["Room Name"].String].notification.mic_speaker_camera_disconnected
      -- Notification Display Disconnected - Zoom Rooms Display is disconnected. Send an email when the TV display is disconnected
      Controls["Notification Display Disconnected"].Boolean = AllZoomRooms[Controls["Room Name"].String].notification.zoom_room_display_disconnected
      -- Notification Digital Signage Empty - Zoom Rooms Digital Signage is enabled with an empty Digital Signage content list. Send an email when a Zoom Room with Digital Signage enabled is no longer showing Digital Signage due to an empty Digital Signage content list.
      Controls["Notification Digital Signage Empty"].Boolean = AllZoomRooms[Controls["Room Name"].String].notification.zoom_room_digital_signage_is_enabled_with_an_empty_digital_signage_content_list
      -- Notification Digital Signage Whiteboard - Zoom Rooms Digital Signage cannot access a Whiteboard in its content list. Send an email when a Zoom Room is configured to show a Whiteboard in Digital Signage, but cannot access the Whiteboard due to incorrect permissions or Whiteboard deletion.
      Controls["Notification Digital Signage Whiteboard"].Boolean = AllZoomRooms[Controls["Room Name"].String].notification.zoom_room_digital_signage_cannot_access_a_whiteboard_in_its_content_list
    end 
  
  

  -- Zoom Room Settings: setting_type=meeting
  -- This information is added to the AllZoomRooms table for the controlled room.
  -- Only a couple of responses/commands are being used.
  elseif getdata.zoom_rooms and getdata.meeting_security then
    AllZoomRooms[Controls["Room Name"].String]["zoom_rooms"] = getdata.zoom_rooms
    AllZoomRooms[Controls["Room Name"].String]["meeting_security"] = getdata.meeting_security

    if AllZoomRooms[Controls["Room Name"].String].zoom_rooms ~= nil and AllZoomRooms[Controls["Room Name"].String].basic.name == Controls["Room Name"].String then
      -- Auto Answer - Automatically accept incoming meeting join request
      Controls["Auto Answer"].Boolean = AllZoomRooms[Controls["Room Name"].String].zoom_rooms.incoming_meeting_request.automatically_accept_incoming_meeting_request
      -- Auto Unmute - Automatically unmute
      Controls["Auto Unmute"].Boolean = AllZoomRooms[Controls["Room Name"].String].zoom_rooms.incoming_meeting_request.automatically_unmute
      -- Show Contact List On Controller
      Controls["Show Contacts On Controller"].Boolean = AllZoomRooms[Controls["Room Name"].String].zoom_rooms.show_contact_list_on_controller
    end 


  -- Zoom Room Settings: setting_type=signage
  -- This information is added to the AllZoomRooms table for the controlled room, but it not used.
  elseif getdata.digital_signage then
    AllZoomRooms[Controls["Room Name"].String]["digital_signage"] = getdata.digital_signage


  -- Zoom Room Settings: setting_type=scheduling_display
  -- This information is added to the AllZoomRooms table for the controlled room, but it not used.
  elseif getdata.scheduling_display then
    AllZoomRooms[Controls["Room Name"].String]["scheduling_display"] = getdata.scheduling_display


  -- Zoom Rooms Virtual Controller URL​
  -- NOTE: url is not returned within a unique table, so if "url" is used in another response this could break.
  elseif getdata.url then
    AllZoomRooms[Controls["Room Name"].String]["url"] = getdata.url

    if AllZoomRooms[Controls["Room Name"].String].url ~= nil and AllZoomRooms[Controls["Room Name"].String].basic.name == Controls["Room Name"].String then
      -- Zoom Room Controller URL
      Controls["Controller URL"].String = AllZoomRooms[Controls["Room Name"].String].url
    end 


  -- List Zoom Room Device Profiles​
  -- NOTE: device profiles are not returned within a unique table, so lastGetRequest variable is used.
  elseif lastGetRequest == "GetDeviceProfile" then
    AllZoomRooms[Controls["Room Name"].String]["device_profile"] = getdata
    
    -- If the Zoom Room does not have any "device_profile"s, end function.
    if AllZoomRooms[Controls["Room Name"].String]["device_profile"][1] == nil then return end
    
    -- Device Profiles
    local deviceprofiles = {}
    for i in pairs(AllZoomRooms[Controls["Room Name"].String]["device_profile"]) do
      --print("Device Profile: "..AllZoomRooms[Controls["Room Name"].String].device_profile[i].name)
      --print("Device Profile: "..AllZoomRooms[Controls["Room Name"].String].device_profile[i].id)
      table.insert(deviceprofiles, AllZoomRooms[Controls["Room Name"].String].device_profile[i].name)
    end
    -- Sort the cameras table alphabetically.
    table.sort(deviceprofiles)
    Controls["Device Profiles"].Choices = deviceprofiles
    
    -- Reset the lastGetRequest
    lastGetRequest = ""

    -- Select the current Default Profile in Controls["Device Profiles"]
    local currentdeviceprofileID = AllZoomRooms[Controls["Room Name"].String].device.device_profile_id
    for i, deviceprofile in ipairs(AllZoomRooms[Controls["Room Name"].String].device_profile) do
      if deviceprofile.id == currentdeviceprofileID then 
        Controls["Device Profiles"].String = deviceprofile.name
        break
      end
    end
  end


  -- Update the 'Room Table' controls for visibility.
  Controls["Room Table"].String = json.encode(AllZoomRooms[Controls["Room Name"].String], {pretty = true})
end


-- PATCH Requests 
function PatchRequestRoomControls(data, method, params)
  HttpClient.Patch {
    Url = "https://api.zoom.us/v2"..data,
    Data = json.encode({
      method = method,
      params = params,
      }), -- the method (eg. zoomroom.unmute) and params needs to be json encoded.
    Headers = {
      ["Content-Type"] = "application/json",
      ["Authorization"] = "Bearer "..access_token -- access token obtained using GetAccessToken()
    },
    EventHandler = PatchRequestDone -- The function to call upon response
  }
end

-- PATCH Requests 
function PatchRequestRoomProfile(data, body)
  HttpClient.Patch {
    Url = "https://api.zoom.us/v2"..data,
    Data = json.encode(
      body
      ), -- the method (eg. zoomroom.unmute) and params needs to be json encoded.
    Headers = {
      ["Content-Type"] = "application/json",
      ["Authorization"] = "Bearer "..access_token -- access token obtained using GetAccessToken()
    },
    EventHandler = PatchRequestDone -- The function to call upon response
  }
end


function PatchRequestDone(tbl, code, data, err)
  print( string.format("Response Code: %i\t\tErrors: %s\rData: %s",code, err or "None", data))
  
  -- Decode the response, then encode to print pretty.
  -- local patchdata = json.decode(data)
  -- print( "\rHTML Data: \n"..json.encode(patchdata, {pretty = true}))
end



-- FUNCTIONS

function Initialize()
  ResetTextIndicators()
end


function ResetTextIndicators()
  for i, control_name in ipairs(Text_Indicators) do
    Controls[control_name].String = ""
  end
end


function SetStatus(code, message, lookup)
  -- if there's a lookup key, fetch the code and message
  if lookup then
    code = status_tbl[lookup].code
    message = status_tbl[lookup].message
  end
  
  Controls["Status"].Value = code
  Controls["Status"].String = message
  
  if (code ~= 0) then return print(string.format("User.Info: Settings Status with Code: '%d', Message: '%s'", code, message)) end
  if (code == 2) then end
end


-- Send GET Zoom Room profile request for each room = https://api.zoom.us/v2/rooms/{roomId}
function BuildRoomProflies()

  if InitialBuildRoomProflies == true then
    -- Set Status to Initializing - Building Room Profiles.
    SetStatus(5, "Building Room Profiles within 'AllZoomRooms' table.")
    InitialBuildRoomProflies = false
  end

  -- Index to track which command to send. Reset to 1 when function is called.
  RoomProfileCurrentIndex = 1

  -- Empty RoomIDs table before building table.
  RoomIDs = {}

  for room_name, room_info in pairs(AllZoomRooms) do
    --print(room_name .. " room_id: "..room_info.room_id)
    table.insert(RoomIDs, room_info.room_id)
  end

  print(#RoomIDs..": RoomIDs in AllZoomRooms Table (type=ZoomRoom)")
  roomProfileSendTimer:Start(0.1)
end

-- roomProfileSendTimer eventhandler.
roomProfileSendTimer.EventHandler = function()

  if RoomProfileCurrentIndex <= #RoomIDs then
    -- Request Room Profile
    GetRequest("/"..RoomIDs[RoomProfileCurrentIndex])
    -- Print and then increase the RoomProfileCurrentIndex for the next time the eventhandler is called.
    print("Index: "..RoomProfileCurrentIndex)
    RoomProfileCurrentIndex = RoomProfileCurrentIndex + 1
  
  else
    roomProfileSendTimer:Stop()

    -- Update the 'All Zoom Rooms Table' controls for visibility.
    Controls["All Zoom Rooms Table"].String = json.encode(AllZoomRooms, {pretty = true})

    -- Once Room Profile details have been added to the AllZoomRooms table, add them to the Contact List.
    Timer.CallAfter(function()
      CreateContactList()
    end, 3)

    -- Start the timer to update the current Zoom Room entry within the AllZoomRoomsTable table entry. Checks first to confirm "Room Name" is valid.
    if AllZoomRooms[Controls["Room Name"].String] ~= nil and AllZoomRooms[Controls["Room Name"].String].basic ~= nil and AllZoomRooms[Controls["Room Name"].String].basic.name == Controls["Room Name"].String then
      UpdateCurrentZoomRoomTimer:Start(5)
    else
      SetStatus(2, "\"Room Name\" is blank or incorrect.")
    end 

    -- Rebuild AllZoomRooms table and RoomProfiles every 30 seconds.
    -- This is to update the Contact List with any new or removed rooms, and update the room_info.status string. (eg. Available, Offline, InMeeting)
    Timer.CallAfter(function()
      GetRequest("?type=ZoomRoom&page_size=100")
    end, 30)

  end
end


-- Create Contact List.
function CreateContactList()
  local contacts = {}
  for room_name, room_info in pairs(AllZoomRooms) do
    if room_info.basic.zoom_room_type == "ZoomRoom" and room_info.setup.under_construction == false and room_info.basic.hide_room_in_contacts == false then
      table.insert(contacts, room_name.." ("..room_info.status..")")
    end
    -- Sort the contacts table alphabetically.
    table.sort(contacts)
  end

  Controls["Contact List"].Choices = contacts
  Controls["Number Of Contacts"].String = #contacts
  print(#contacts..": Number Of Contacts (ZoomRoom's that are not 'Under Construction' or 'Hidden From Contacts').")

end


-- UpdateCurrentZoomRoomTimer Eventhandler
-- Update current Zoom Room entry within the AllZoomRoomsTable table entry.
UpdateCurrentZoomRoomTimer.EventHandler = function()
  -- stop the timer.
  UpdateCurrentZoomRoomTimer:Stop()
  -- send GET requests to update status and details of the current Zoom Room.
  --GetRequest("?query_name="..Controls["Room Name"].String)
  GetRequest("?query_name="..HttpClient.EncodeString(Controls["Room Name"].String))
  GetRequest("/"..AllZoomRooms[Controls["Room Name"].String].room_id)
  GetRequest("/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/devices")
  GetRequest("/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/device_profiles/devices")
  GetRequest("/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/settings?setting_type=alert")
  GetRequest("/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/settings?setting_type=meeting")
  GetRequest("/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/settings?setting_type=scheduling_display")
  GetRequest("/"..AllZoomRooms[Controls["Room Name"].String].id.."/virtual_controller")
  GetRequest("/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/settings?setting_type=signage")
  
  GetRequest("/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/device_profiles")
  lastGetRequest = "GetDeviceProfile"

  -- start the timer again to repeat the refreshing of the current Zoom Room.
  UpdateCurrentZoomRoomTimer:Start(5)

end




-- List Zoom Rooms = https://api.zoom.us/v2/rooms/
-- Query Parameters:
  -- status = Type: string enum. The status of the Zoom Room. (Offline, Available, InMeeting, UnderConstruction)
  -- tag_ids = Type: string. The room tag IDs associated with the Zoom Room. Use commas (,) to separate between them. It's 'OR' logic if query for multiple tags.
  -- type = Type: string enum. The type of Zoom Rooms. (Kiosk, ZoomRoom, StandaloneWhiteboard, SchedulingDisplayOnly, DigitalSignageOnly, PersonalZoomRoom)
  -- unassigned_rooms =  Type: boolean default: false. Use this query parameter with a value of true if you would like to see Zoom Rooms in your account that have not been assigned to anyone yet.
  -- page_size =  Type: integer max: 300 default: 30. The number of records returned within a single API call.
  -- next_page_token = Type: string. Use the next page token to paginate through large result sets. A next page token is returned whenever the set of available results exceeds the current page size. This token's expiration period is 15 minutes.
  -- location_id = Type: string. The parent location ID of the Zoom Room.
  -- query_name = Type: string. The name of a Zoom Room. If you do not call this parameter, the API will return all of the account's Zoom Rooms.


-- Get Zoom Room profile = https://api.zoom.us/v2/rooms/{roomId}
-- Path Parameters:
  -- roomId = Type: string (required). The unique identifier of the Zoom Room. This can be retrieved from the response of the List Zoom Rooms API.
-- Query Parameters:
  -- regenerate_activation_code. Type: boolean default: false. Whether to regenerate an activation code for a Zoom Room. Default is false.


-- List Zoom Room devices = https://api.zoom.us/v2/rooms/{roomId}/devices
-- Path Parameters:
  -- roomId = Type: string (required). Unique Identifier of the Zoom Room. This can be retrieved from the response of List Zoom Rooms API.


-- Get device information = https://api.zoom.us/v2/rooms/{roomId}/device_profiles/devices
-- Path Parameters:
  -- roomId = Type: string (required). The Zoom Room's ID.


-- List device profiles = https://api.zoom.us/v2/rooms/{roomId}/device_profiles
-- Path Parameters:
  -- roomId = Type: string (required). The Zoom Room's ID.


-- Get a device profile = https://api.zoom.us/v2/rooms/{roomId}/device_profiles/{deviceProfileId}
-- Path Parameters:
  -- roomId = Type: string (required) The Zoom Room's ID.
  -- deviceProfileId = Type: string (required). The Zoom Room device profile's ID.


-- Get Zoom Room settings = https://api.zoom.us/v2/rooms/{roomId}/settings
-- Path Parameters:
  -- roomId = Type: string (required) Unique Identifier of the Zoom Room.
-- Query Parameters:
-- setting_type Type: string default: "meeting" (required). The type of setting that you would like to retrieve.
  -- alert: Alert settings of the Zoom Room.
  -- meeting: Meeting settings of the Zoom Room.
  -- signage: Digital Signage settings of the Zoom Room.
  -- scheduling_display: Scheduling Display settings of the Zoom Room.


-- Get Zoom Rooms virtual controller URL = https://api.zoom.us/v2/rooms/{id}/virtual_controller
-- Path Parameters:
  -- roomId = Type: string (required). The unique identifier of the Zoom Room. This can be retrieved from the response of the List Zoom Rooms API.
-- Query Parameters:
  -- pre_authenticated_link = Type: boolean. If true, the URL for the virtual controller will contain a time-limited authentication token (10 minute lifetime) that will permit to the virtual controller without requiring login to Zoom admin portal. Default is false.


-- Zoom Room controls​ = https://api.zoom.us/v2/rooms/{id}/events
  -- Controls Zoom Rooms, including:
    -- Room check-in and check-out.
      -- zoomroom.check_in
      -- zoomroom.check_out
    -- Video and audio mute on and off.
      -- zoomroom.mute
      -- zoomroom.unmute
      -- zoomroom.video_mute
      -- zoomroom.video_unmute
    -- Incoming meeting request accept or decline.
      -- zoomroom.meeting_accept
      -- zoomroom.meeting_decline
    -- Meeting join, leave, or end.
      -- zoomroom.meeting_join (Params: meeting_number Type:string (required), passcode Type:string, force_accept Type:boolean, make_zoom_room_host Type:boolean)
      -- zoomroom.meeting_leave
      -- zoomroom.meeting_invite (Params: user_ids Type:array string[] (required)). For Rooms, the "id" (not room_id) is the user_id.
      -- zoomroom.meeting_cancel (Params: meeting_topic Type:string (required), start_time Type:string(required), duration Type:integer, timezone Type:string)
      -- zoomroom.meeting_end
      -- zoomroom.meeting_schedule (Params: meeting_topic Type:string (required), start_time Type:string (required), passcode Type:string, duration Type:integer, timezone Type:string, settings Type:object (join_before_host Type:boolean))
      -- zoomroom.thirdparty_meeting_join (Params: event_id Type:string, passcode Type:string, join_type Type:string enum, meeting_source_type Type:string enum, join_url Type:string, sip_address Type:string, third_party_meeting_id Type:string)
    -- Room restart. Restart the Zoom Rooms app running on the PC.
      -- zoomroom.restart
    -- Cancellation.
    -- Switch between available cameras, speakers or microphones during a meeting.
      -- zoomroom.switch_camera (Params: cameraId Type:string (required))
      -- zoomroom.switch_microphone (Params: microphoneId Type:string (required))
      -- zoomroom.switch_speaker (Params: speakerId Type:string (required))
    -- Start or stop screen sharing.
      -- zoomroom.share_content_start
      -- zoomroom.share_content_stop
    -- Perform speaker volume changes during a meeting.
      -- zoomroom.volume_level (Params: volume_level Type:integer)
    -- Alerts. Start a Zoom Room alert.
      -- zoomroom.alarm_start
      -- zoomroom.alarm_stop
  -- Path Parameters:
    -- id: Type:string (required) = The room ID.



-- Eventhandlers

-- Zoom Room Controls
-- Meeting join, leave, or end.
-- zoomroom.meeting_join (Params: meeting_number Type:string (required), passcode Type:string, force_accept Type:boolean, make_zoom_room_host Type:boolean)
-- zoomroom.thirdparty_meeting_join (Params: meeting_source_type Type:string, third_party_meeting_id Type:string, passcode Type:string, sip_address Type:string, join_url Type:string, event_id Type:string)

 -- Join Meeting (instant Zoom meeting)
Controls["New Meeting"].EventHandler = function()
  PatchRequestRoomControls("/rooms/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/events", "zoomroom.meeting_join", {meeting_number = ""})
end

Controls["Join Meeting"].EventHandler = function()
  -- Zoom Meeting: Meet Now / New Meeting (instant Zoom meeting)
  if Controls["Meeting ID"].String == "" and Controls["Meeting Source"].String == "Zoom" then
    PatchRequestRoomControls("/rooms/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/events", "zoomroom.meeting_join", {meeting_number = ""})
  -- Zoom Meeting: Meeting ID, No Passcode
  elseif Controls["Meeting ID"].String ~= "" and Controls["Password"].String == "" and Controls["Meeting Source"].String == "Zoom" then
    PatchRequestRoomControls("/rooms/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/events", "zoomroom.meeting_join", {meeting_number = Controls["Meeting ID"].String}) -- Join Meeting with ID (no passcode)
  -- Zoom Meeting: Meeting ID & Passcode
  elseif Controls["Meeting ID"].String ~= "" and Controls["Password"].String ~= "" and Controls["Meeting Source"].String == "Zoom" then
    PatchRequestRoomControls("/rooms/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/events", "zoomroom.meeting_join", {meeting_number = Controls["Meeting ID"].String , passcode = Controls["Password"].String}) -- Join Meeting with ID (with passcode)
  -- MS Teams Meeting: Meeting ID & Passcode
  elseif Controls["Meeting ID"].String ~= "" and Controls["Password"].String ~= "" and Controls["Meeting Source"].String == "Microsoft Teams" then
    PatchRequestRoomControls("/rooms/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/events", "zoomroom.thirdparty_meeting_join", {join_type = "meeting_id", meeting_source_type = "MS_TEAMS", third_party_meeting_id = Controls["Meeting ID"].String, passcode = Controls["Password"].String}) -- Meeting Join MS Teams
  end
end

-- zoomroom.meeting_leave
Controls["Meeting Leave"].EventHandler = function()
  PatchRequestRoomControls("/rooms/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/events", "zoomroom.meeting_leave")
end

-- zoomroom.meeting_end
Controls["Meeting End"].EventHandler = function()
  PatchRequestRoomControls("/rooms/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/events", "zoomroom.meeting_end")
end

