end

-- Video and audio mute on and off.
-- zoomroom.mute
-- zoomroom.unmute
Controls["Microphone Mute"].EventHandler = function(ctl)
  if ctl.Boolean == true then
    PatchRequestRoomControls("/rooms/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/events", "zoomroom.mute")
  elseif ctl.Boolean == false then
    PatchRequestRoomControls("/rooms/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/events", "zoomroom.unmute")
  end
end

-- zoomroom.video_mute
-- zoomroom.video_unmute
Controls["Camera Mute"].EventHandler = function(ctl)
  if ctl.Boolean == true then
    PatchRequestRoomControls("/rooms/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/events", "zoomroom.video_mute")
  elseif ctl.Boolean == false then
    PatchRequestRoomControls("/rooms/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/events", "zoomroom.video_unmute")
  end
end

-- Share Content Start. Start sharing content on the Zoom Rooms client.
-- Only works within a meeting to bring up the Sharing Instructions. Cannot be used to Start HDMI share.
-- zoomroom.share_content_start
Controls["Share Content Start"].EventHandler = function()
  PatchRequestRoomControls("/rooms/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/events", "zoomroom.share_content_start")
end

-- Share Content Stop. Stop sharing content on the Zoom Rooms client.
-- Only works within a meeting to hide the Sharing Instructions, or if HDMI is sharing, it will end HDMI Share.
-- zoomroom.share_content_stop
Controls["Share Content Stop"].EventHandler = function()
  PatchRequestRoomControls("/rooms/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/events", "zoomroom.share_content_stop")
end

-- Switch Camera. Switch the camera used by the Zoom Rooms client during a meeting. This API has no effect if the Zoom Rooms client is not in a meeting.
-- Zoom Room will revert back to default selection when meeting ends.
-- zoomroom.switch_camera (params = cameraId)
Controls["Switch Camera"].EventHandler = function()
  -- find Camera ID within AllZoomRooms table.
  local switchcameraID = nil
    for i, cam in ipairs(AllZoomRooms[Controls["Room Name"].String].cameras) do
      if cam.name == Controls["Cameras"].String then 
        switchcameraID = cam.id
        break
      end
    end
  PatchRequestRoomControls("/rooms/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/events", "zoomroom.switch_camera", {cameraId = switchcameraID})
end

-- Switch Microphone. Switch the microphone used by the Zoom Rooms client during a meeting. This API has no effect if the Zoom Rooms client is not in a meeting.
-- Zoom Room will revert back to default selection when meeting ends.
-- zoomroom.switch_microphone (params = microphoneId)
Controls["Switch Microphone"].EventHandler = function()
  -- find Camera ID within AllZoomRooms table.
  local switchmicrophoneID = nil
    for i, mic in ipairs(AllZoomRooms[Controls["Room Name"].String].microphones) do
      if mic.name == Controls["Microphones"].String then 
        switchmicrophoneID = mic.id
        break
      end
    end
  PatchRequestRoomControls("/rooms/"..AllZoomRooms[Controls["Room Name"].String].room_id.."/events", "zoomroom.switch_microphone", {microphoneId = switchmicrophoneID})
end

-- Switch Speaker. Switch the speaker used by the Zoom Rooms client during a meeting. This API has no effect if the Zoom Rooms client is not in a meeting.
-- Zoom Room will revert back to default selection when meeting ends.
-- zoomroom.switch_speaker (params = speakerId)
Controls["Switch Speaker"].EventHandler = function()
  -- find Camera ID within AllZoomRooms table.
  local switchspeakerID = nil
    for i, speaker in ipairs(AllZoomRooms[Controls["Room Name"].String].speakers) do
      if speaker.name == Controls["Speakers"].String then 
